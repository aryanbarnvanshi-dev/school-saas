# Server & Domain Configuration
PORT=3000
ROOT_DOMAIN=campusdesk.site
APP_NAME=CampusDesk

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Gmail SMTP for OTP Dispatch
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASS=your-16-char-app-password

# Super Admin Initial Bootstrap Credentials (used by scripts/reset_super_admin.js)
SUPER_ADMIN_EMAIL=admin@campusdesk.site
SUPER_ADMIN_PASSWORD=YourStrongSuperAdminPassword@2026
